# 로컬 개발용 설정. 이 파일을 application-local.yml 로 복사한 뒤 값을 채우세요. (application-local.yml 은 git 미추적)
# 값은 docker-compose 가 읽는 .env 와 맞춰야 합니다.
spring:
  datasource:
    url: jdbc:mariadb://localhost:3307/pickone
    username: pickone
    password:
  data:
    redis:
      host: localhost
      port: 6380

pickone:
  swagger:
    # 로컬에서는 Swagger UI 를 켠다 (application.yml 기본값은 꺼짐)
    enabled: true
  jwt:
    # 32바이트 이상 임의 문자열. 예: openssl rand -base64 48
    secret:
  crypto:
    # AES 키: openssl rand -base64 32 / HMAC 키: 32자 이상 임의 문자열 (두 값은 서로 다르게)
    phone-aes-key:
    phone-hmac-key:
