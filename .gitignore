.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IntelliJ
.idea/
*.iml
out/

# 비밀 설정 (DB 비밀번호, 암호화 키 등)
.env
**/application-local.yml
**/application-secret.yml

# 앱 (Expo / Node)
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.env*.local
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
# Expo 가 자동 생성하는 네이티브 폴더와 서명 파일
/app/ios
/app/android
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# OS
.DS_Store
Thumbs.db
